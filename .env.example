# Configuration of space-server. Copy outside the repository, e.g. to
# ~/.config/himasif-space/dev.env (chmod 600), and pass it with -env-file
# (make serve does). Never commit real values.

# development | production
SPACE_ENV=development
SPACE_HTTP_ADDR=127.0.0.1:8787
# Where people open Space; used in email links.
SPACE_PUBLIC_URL=http://localhost:8787
SPACE_DATABASE_URL=postgres://space:CHANGE_ME@127.0.0.1:5432/space?sslmode=disable
# A role that may create databases; the server tests make and drop one per test.
SPACE_TEST_DATABASE_URL=postgres://space:CHANGE_ME@127.0.0.1:5432/space_test_release?sslmode=disable
# The built web app (make web); empty serves the API only.
SPACE_WEB_DIR=./app/build/web
SPACE_SESSION_TTL=720h

# Email: "disabled" refuses to send, "log" only logs recipient and subject,
# "smtp" sends.
# Development: Mailpit on 127.0.0.1:1025 with SPACE_SMTP_TLS=none.
# Production: the SMTP of the provider chosen (Zoho Mail, Amazon SES, …).
SPACE_MAIL_DRIVER=log
# Production: an address @himasif.id (the verified SES identity) is required.
SPACE_MAIL_FROM=HIMASIF Space <no-reply@himasif.id>
SPACE_SMTP_HOST=
SPACE_SMTP_PORT=587
# starttls | tls | none (development only)
SPACE_SMTP_TLS=starttls
SPACE_SMTP_USERNAME=
SPACE_SMTP_PASSWORD=
# Emails per minute, all addresses together (SES: 1/s in the sandbox).
SPACE_MAIL_PER_MINUTE=20
# Amazon SNS topic that SES publishes bounces and complaints to; empty turns
# POST /api/mail/ses-events off. See docs/operations/ses-email.md.
SPACE_SES_SNS_TOPIC_ARN=

# The organization admin account that `space-server seed` creates when none
# exists yet. Change the password after the first login (Sesi 1B adds it).
SPACE_ADMIN_EMAIL=
SPACE_ADMIN_PASSWORD=

# External sources (server-side only; never connector API payloads).
# Share approved spreadsheets with this service account. Keep its JSON outside
# the repository. An explicit access token can be used in development instead.
SPACE_GOOGLE_SERVICE_ACCOUNT=
SPACE_GOOGLE_ACCESS_TOKEN=
SPACE_GOOGLE_DRIVE_ACCESS_TOKEN=
SPACE_TRELLO_KEY=
SPACE_TRELLO_TOKEN=
# Real external writes remain disabled until the mapping/cutover is reviewed.
SPACE_EXTERNAL_WRITES_ENABLED=false

# Separate WhatsApp bridge (disabled while URL/token are empty).
# Same bearer token as bridge/.env; never expose it in desktop/mobile clients.
SPACE_WA_BRIDGE_URL=
SPACE_WA_BRIDGE_TOKEN=

# Private binary attachments; keep outside SPACE_WEB_DIR and back up separately.
SPACE_ATTACHMENT_DIR=space-data/attachments
SPACE_ATTACHMENT_MAX_BYTES=20971520

# live | isolated_restore | maintenance. Restore mode also needs a DB quarantine marker.
SPACE_RUN_MODE=live
